+
+/* For a command that returns no result: stops the context when the create
+ * info or the plane is not valid.
+ */
+static bool
+vkr_image_validate_device_image_info(struct vn_dispatch_context *dispatch,
+                                     struct vkr_device *dev,
+                                     const VkDeviceImageMemoryRequirements *info)
+{
+   struct vkr_image_info image;
+   uint32_t planes;
+
+   if (!info || !vkr_validate_image_create_info(dev->physical_device,
+                                                (VkImageCreateInfo *)info->pCreateInfo)) {
+      vkr_context_set_fatal(dispatch->data);
+      return false;
+   }
+
+   vkr_image_info_init(&image, info->pCreateInfo);
+   if (!vkr_validate_image_planes(&image, info->planeAspect != 0, info->planeAspect,
+                                  &planes)) {
+      vkr_context_set_fatal(dispatch->data);
+      return false;
+   }
+
+   return true;
+}
+
+/* For a command that returns no result: stops the context when the guest
+ * gave no image or a plane that the image does not have.
+ */
+static bool
+vkr_image_validate_planes(struct vn_dispatch_context *dispatch,
+                          const struct vkr_image *img,
+                          const VkImagePlaneMemoryRequirementsInfo *plane_info)
+{
+   uint32_t planes;
+
+   if (!vkr_validate_image_planes(img ? &img->info : NULL, plane_info != NULL,
+                                  plane_info ? plane_info->planeAspect : 0, &planes)) {
+      vkr_context_set_fatal(dispatch->data);
+      return false;
+   }
+   return true;
+}
+
+static bool
+vkr_image_validate_subresource(struct vn_dispatch_context *dispatch,
+                               const struct vkr_image *img,
+                               const VkImageSubresource *subres)
+{
+   if (!vkr_validate_image_subresource(img ? &img->info : NULL, subres)) {
+      vkr_context_set_fatal(dispatch->data);
+      return false;
+   }
+   return true;
 }
 
