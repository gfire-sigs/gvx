diff --git a/src/venus/vkr_validate.c b/src/venus/vkr_validate.c
new file mode 100644
index 0000000..5a47789
--- /dev/null
+++ b/src/venus/vkr_validate.c
@@ -0,0 +1,866 @@
+/*
+ * Copyright 2026 The gVisor Authors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "vkr_validate.h"
+
+#include "vkr_format_table.h"
+#include "vkr_physical_device.h"
+
+/* A guest can make a test fail at any rate, so each log has a line limit. */
+#define VKR_VALIDATE_LOG_LIMIT 64
+#define VKR_VALIDATE_QUIRK_LOG_LIMIT 8
+
+/* Returns true for the first limit calls. */
+static bool
+vkr_validate_log_allowed(atomic_uint *line_count, unsigned limit)
+{
+   if (atomic_load(line_count) >= limit)
+      return false;
+   return atomic_fetch_add(line_count, 1) < limit;
+}
+
+static bool PRINTFLIKE(1, 2)
+vkr_validate_fail(const char *fmt, ...)
+{
+   static atomic_uint line_count;
+
+   if (vkr_validate_log_allowed(&line_count, VKR_VALIDATE_LOG_LIMIT)) {
+      va_list va;
+      va_start(va, fmt);
+      virgl_prefixed_logv("vkr", VIRGL_LOG_LEVEL_WARNING, fmt, va);
+      va_end(va);
+   }
+
+   return false;
+}
+
+/* Returns NULL for a format that the Vulkan registry of the protocol does
+ * not have.
+ */
+static const struct vkr_format_entry *
+vkr_format_lookup(VkFormat format)
+{
+   const uint32_t f = (uint32_t)format;
+   uint32_t begin = 0;
+   uint32_t end = ARRAY_SIZE(vkr_format_table);
+
+   while (begin < end) {
+      const uint32_t mid = begin + (end - begin) / 2;
+      if (vkr_format_table[mid].format == f)
+         return &vkr_format_table[mid];
+      if (vkr_format_table[mid].format < f)
+         begin = mid + 1;
+      else
+         end = mid;
+   }
+   return NULL;
+}
+
+/* Returns the compatible format of each plane of a multi-planar format. */
+static const uint32_t *
+vkr_format_get_plane_formats(VkFormat format)
+{
+   for (uint32_t i = 0; i < ARRAY_SIZE(vkr_format_planes_table); i++) {
+      if (vkr_format_planes_table[i].format == (uint32_t)format)
+         return vkr_format_planes_table[i].plane_formats;
+   }
+   return NULL;
+}
+
+/* Returns true when a and b are in one compatibility class. */
+static bool
+vkr_format_is_compatible(VkFormat a, VkFormat b)
+{
+   const struct vkr_format_entry *entry_a = vkr_format_lookup(a);
+   const struct vkr_format_entry *entry_b = vkr_format_lookup(b);
+   return entry_a && entry_b && entry_a->class_id == entry_b->class_id;
+}
+
+/* Returns the aspects of a depth and stencil format, or 0 for other formats. */
+static VkImageAspectFlags
+vkr_format_get_depth_stencil_aspects(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_D16_UNORM:
+   case VK_FORMAT_X8_D24_UNORM_PACK32:
+   case VK_FORMAT_D32_SFLOAT:
+      return VK_IMAGE_ASPECT_DEPTH_BIT;
+   case VK_FORMAT_S8_UINT:
+      return VK_IMAGE_ASPECT_STENCIL_BIT;
+   case VK_FORMAT_D16_UNORM_S8_UINT:
+   case VK_FORMAT_D24_UNORM_S8_UINT:
+   case VK_FORMAT_D32_SFLOAT_S8_UINT:
+      return VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT;
+   default:
+      return 0;
+   }
+}
+
+static void
+vkr_format_get_features(struct vkr_physical_device *physical_dev,
+                        VkFormat format,
+                        VkFormatProperties *props)
+{
+   struct vn_physical_device_proc_table *vk = &physical_dev->proc_table;
+
+   memset(props, 0, sizeof(*props));
+   vk->GetPhysicalDeviceFormatProperties(physical_dev->base.handle.physical_device,
+                                         format, props);
+}
+
+/* Sets plane to the index of a plane aspect of image. */
+static bool
+vkr_image_get_plane(const struct vkr_image_info *image,
+                    VkImageAspectFlags aspect,
+                    uint32_t *plane)
+{
+   switch (aspect) {
+   case VK_IMAGE_ASPECT_PLANE_0_BIT:
+      *plane = 0;
+      break;
+   case VK_IMAGE_ASPECT_PLANE_1_BIT:
+      *plane = 1;
+      break;
+   case VK_IMAGE_ASPECT_PLANE_2_BIT:
+      *plane = 2;
+      break;
+   default:
+      return false;
+   }
+   return image->plane_count > 1 && *plane < image->plane_count;
+}
+
+static bool
+vkr_image_aspect_is_memory_plane(VkImageAspectFlags aspect)
+{
+   return aspect == VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT ||
+          aspect == VK_IMAGE_ASPECT_MEMORY_PLANE_1_BIT_EXT ||
+          aspect == VK_IMAGE_ASPECT_MEMORY_PLANE_2_BIT_EXT ||
+          aspect == VK_IMAGE_ASPECT_MEMORY_PLANE_3_BIT_EXT;
+}
+
+/* The image creation limits of the Vulkan specification. */
+struct vkr_image_limits {
+   VkExtent3D max_extent;
+   uint32_t max_mip_levels;
+   uint32_t max_array_layers;
+   VkSampleCountFlags sample_counts;
+};
+
+/*
+ * Gets the limits of the driver for the format, type, tiling, usage, and
+ * flags of info.  Returns false when the driver does not support them.
+ *
+ * VkExternalMemoryImageCreateInfo is not a part of the query.  The handle
+ * types of the guest are not those of the host, and
+ * vkr_dispatch_vkCreateImage gives them to the driver as they are.
+ */
+static bool
+vkr_image_get_limits(struct vkr_physical_device *physical_dev,
+                     const VkImageCreateInfo *info,
+                     struct vkr_image_limits *limits)
+{
+   struct vn_physical_device_proc_table *vk = &physical_dev->proc_table;
+   if (!vk->GetPhysicalDeviceImageFormatProperties2)
+      return false;
+
+   VkPhysicalDeviceImageFormatInfo2 format_info = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2,
+      .format = info->format,
+      .type = info->imageType,
+      .tiling = info->tiling,
+      .usage = info->usage,
+      .flags = info->flags,
+   };
+
+   VkImageStencilUsageCreateInfo stencil_usage;
+   const VkImageStencilUsageCreateInfo *guest_stencil_usage =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_IMAGE_STENCIL_USAGE_CREATE_INFO);
+   if (guest_stencil_usage) {
+      stencil_usage = *guest_stencil_usage;
+      stencil_usage.pNext = format_info.pNext;
+      format_info.pNext = &stencil_usage;
+   }
+
+   VkImageFormatListCreateInfo format_list;
+   const VkImageFormatListCreateInfo *guest_format_list =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO);
+   if (guest_format_list) {
+      format_list = *guest_format_list;
+      format_list.pNext = format_info.pNext;
+      format_info.pNext = &format_list;
+   }
+
+   /* The specification wants each modifier of a list to be compatible with
+    * the create info, and the limits of the image are the minimum of the
+    * limits of all modifiers.
+    */
+   VkPhysicalDeviceImageDrmFormatModifierInfoEXT modifier_info = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_DRM_FORMAT_MODIFIER_INFO_EXT,
+      .sharingMode = info->sharingMode,
+      .queueFamilyIndexCount = info->queueFamilyIndexCount,
+      .pQueueFamilyIndices = info->pQueueFamilyIndices,
+   };
+   const uint64_t *modifiers = NULL;
+   uint32_t query_count = 1;
+   if (info->tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT) {
+      if (!physical_dev->EXT_image_drm_format_modifier)
+         return false;
+
+      const VkImageDrmFormatModifierExplicitCreateInfoEXT *explicit_info =
+         vkr_find_struct(
+            info->pNext,
+            VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT);
+      const VkImageDrmFormatModifierListCreateInfoEXT *list_info = vkr_find_struct(
+         info->pNext, VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT);
+      if (explicit_info && !list_info) {
+         modifiers = &explicit_info->drmFormatModifier;
+      } else if (list_info && !explicit_info && list_info->drmFormatModifierCount &&
+                 list_info->pDrmFormatModifiers) {
+         modifiers = list_info->pDrmFormatModifiers;
+         query_count = list_info->drmFormatModifierCount;
+      } else {
+         return false;
+      }
+
+      modifier_info.pNext = format_info.pNext;
+      format_info.pNext = &modifier_info;
+   }
+
+   for (uint32_t i = 0; i < query_count; i++) {
+      if (modifiers)
+         modifier_info.drmFormatModifier = modifiers[i];
+
+      VkImageFormatProperties2 props = {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2,
+      };
+      const VkResult result = vk->GetPhysicalDeviceImageFormatProperties2(
+         physical_dev->base.handle.physical_device, &format_info, &props);
+      if (result != VK_SUCCESS)
+         return false;
+
+      const VkImageFormatProperties *p = &props.imageFormatProperties;
+      if (i == 0) {
+         limits->max_extent = p->maxExtent;
+         limits->max_mip_levels = p->maxMipLevels;
+         limits->max_array_layers = p->maxArrayLayers;
+         limits->sample_counts = p->sampleCounts;
+      } else {
+         limits->max_extent.width = MIN2(limits->max_extent.width, p->maxExtent.width);
+         limits->max_extent.height =
+            MIN2(limits->max_extent.height, p->maxExtent.height);
+         limits->max_extent.depth = MIN2(limits->max_extent.depth, p->maxExtent.depth);
+         limits->max_mip_levels = MIN2(limits->max_mip_levels, p->maxMipLevels);
+         limits->max_array_layers = MIN2(limits->max_array_layers, p->maxArrayLayers);
+         limits->sample_counts &= p->sampleCounts;
+      }
+   }
+
+   return true;
+}
+
+bool
+vkr_validate_image_create_info(struct vkr_physical_device *physical_dev,
+                               VkImageCreateInfo *info)
+{
+   if (!info)
+      return vkr_validate_fail("image: no create info");
+
+   const VkExtent3D *extent = &info->extent;
+   if (!extent->width || !extent->height || !extent->depth || !info->mipLevels ||
+       !info->arrayLayers || !info->usage) {
+      return vkr_validate_fail(
+         "image: extent %ux%ux%u, %u levels, %u layers, or usage 0x%x is zero",
+         extent->width, extent->height, extent->depth, info->mipLevels,
+         info->arrayLayers, info->usage);
+   }
+
+   bool ok;
+   switch (info->imageType) {
+   case VK_IMAGE_TYPE_1D:
+      ok = extent->height == 1 && extent->depth == 1;
+      break;
+   case VK_IMAGE_TYPE_2D:
+      ok = extent->depth == 1;
+      break;
+   case VK_IMAGE_TYPE_3D:
+      ok = info->arrayLayers == 1;
+      break;
+   default:
+      ok = false;
+      break;
+   }
+   if (!ok) {
+      return vkr_validate_fail("image: type %d does not allow extent %ux%ux%u, %u layers",
+                               info->imageType, extent->width, extent->height,
+                               extent->depth, info->arrayLayers);
+   }
+
+   switch (info->tiling) {
+   case VK_IMAGE_TILING_OPTIMAL:
+   case VK_IMAGE_TILING_LINEAR:
+   case VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT:
+      break;
+   default:
+      return vkr_validate_fail("image: tiling %d is not valid", info->tiling);
+   }
+
+   if (!util_is_power_of_two_nonzero(info->samples) ||
+       info->samples > VK_SAMPLE_COUNT_64_BIT)
+      return vkr_validate_fail("image: sample count 0x%x is not valid", info->samples);
+
+   const uint32_t max_dim = MAX3(extent->width, extent->height, extent->depth);
+   if (info->mipLevels > util_logbase2(max_dim) + 1) {
+      return vkr_validate_fail("image: %u levels are too many for extent %ux%ux%u",
+                               info->mipLevels, extent->width, extent->height,
+                               extent->depth);
+   }
+
+   /* The chroma planes of these formats have one half of the width, or of
+    * the width and the height.  An odd extent can give a plane of size 0.
+    */
+   const struct vkr_format_entry *entry = vkr_format_lookup(info->format);
+   if (!entry)
+      return vkr_validate_fail("image: format %d is not known", info->format);
+   if (((entry->flags & (VKR_FORMAT_FLAG_CHROMA_420 | VKR_FORMAT_FLAG_CHROMA_422)) &&
+        (extent->width & 1)) ||
+       ((entry->flags & VKR_FORMAT_FLAG_CHROMA_420) && (extent->height & 1))) {
+      return vkr_validate_fail("image: format %d does not allow the odd extent %ux%u",
+                               info->format, extent->width, extent->height);
+   }
+
+   if ((info->flags & VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT) &&
+       (info->imageType != VK_IMAGE_TYPE_2D || extent->width != extent->height ||
+        info->arrayLayers < 6)) {
+      return vkr_validate_fail(
+         "image: cube flag does not allow type %d, extent %ux%u, %u layers",
+         info->imageType, extent->width, extent->height, info->arrayLayers);
+   }
+
+   const VkImageCreateFlags flags_2d_of_3d =
+      VK_IMAGE_CREATE_2D_ARRAY_COMPATIBLE_BIT | VK_IMAGE_CREATE_2D_VIEW_COMPATIBLE_BIT_EXT;
+   if ((info->flags & flags_2d_of_3d) && info->imageType != VK_IMAGE_TYPE_3D) {
+      return vkr_validate_fail("image: flags 0x%x need type 3D, not type %d", info->flags,
+                               info->imageType);
+   }
+
+   if ((info->flags & VK_IMAGE_CREATE_BLOCK_TEXEL_VIEW_COMPATIBLE_BIT) &&
+       (!(entry->flags & VKR_FORMAT_FLAG_COMPRESSED) ||
+        !(info->flags & VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT))) {
+      return vkr_validate_fail("image: flags 0x%x do not allow format %d", info->flags,
+                               info->format);
+   }
+
+   if (info->samples != VK_SAMPLE_COUNT_1_BIT &&
+       (info->imageType != VK_IMAGE_TYPE_2D ||
+        (info->flags & VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT) || info->mipLevels != 1 ||
+        info->tiling == VK_IMAGE_TILING_LINEAR)) {
+      return vkr_validate_fail(
+         "image: %d samples do not allow type %d, flags 0x%x, %u levels, tiling %d",
+         info->samples, info->imageType, info->flags, info->mipLevels, info->tiling);
+   }
+
+   struct vkr_image_limits limits;
+   if (!vkr_image_get_limits(physical_dev, info, &limits)) {
+      return vkr_validate_fail(
+         "image: no driver support for format %d, type %d, tiling %d, usage 0x%x, "
+         "flags 0x%x",
+         info->format, info->imageType, info->tiling, info->usage, info->flags);
+   }
+   if (extent->width > limits.max_extent.width ||
+       extent->height > limits.max_extent.height ||
+       extent->depth > limits.max_extent.depth ||
+       info->mipLevels > limits.max_mip_levels ||
+       info->arrayLayers > limits.max_array_layers ||
+       !(limits.sample_counts & info->samples)) {
+      return vkr_validate_fail("image: extent %ux%ux%u, %u levels, %u layers, or %d "
+                               "samples is more than the limit of format %d",
+                               extent->width, extent->height, extent->depth,
+                               info->mipLevels, info->arrayLayers, info->samples,
+                               info->format);
+   }
+
+   /* See vkr_physical_device::image_3d_alias_quirk.  The image is valid, and
+    * it stays usable as a 3D image.  Without the flags,
+    * vkr_validate_image_view_create_info refuses 2D views of it.
+    */
+   if (physical_dev->image_3d_alias_quirk && (info->flags & flags_2d_of_3d) &&
+       info->mipLevels > util_logbase2(MAX2(extent->width, extent->height)) + 1) {
+      static atomic_uint line_count;
+      if (vkr_validate_log_allowed(&line_count, VKR_VALIDATE_QUIRK_LOG_LIMIT)) {
+         vkr_log("3D image workaround: 2D views are off for extent %ux%ux%u, %u levels",
+                 extent->width, extent->height, extent->depth, info->mipLevels);
+      }
+      info->flags &= ~flags_2d_of_3d;
+   }
+
+   return true;
+}
+
+void
+vkr_image_info_init(struct vkr_image_info *image, const VkImageCreateInfo *info)
+{
+   const struct vkr_format_entry *entry = vkr_format_lookup(info->format);
+   const VkImageStencilUsageCreateInfo *stencil_usage =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_IMAGE_STENCIL_USAGE_CREATE_INFO);
+
+   *image = (struct vkr_image_info){
+      .flags = info->flags,
+      .type = info->imageType,
+      .format = info->format,
+      .extent = info->extent,
+      .mip_levels = info->mipLevels,
+      .array_layers = info->arrayLayers,
+      .samples = info->samples,
+      .tiling = info->tiling,
+      .usage = info->usage | (stencil_usage ? stencil_usage->stencilUsage : 0),
+      .plane_count = entry && entry->plane_count ? entry->plane_count : 1,
+   };
+}
+
+bool
+vkr_validate_image_subresource(const struct vkr_image_info *image,
+                               const VkImageSubresource *subres)
+{
+   if (!image || !subres)
+      return vkr_validate_fail("image subresource: no image or no subresource");
+
+   if (subres->mipLevel >= image->mip_levels ||
+       subres->arrayLayer >= image->array_layers) {
+      return vkr_validate_fail(
+         "image subresource: level %u, layer %u is not in %u levels, %u layers",
+         subres->mipLevel, subres->arrayLayer, image->mip_levels, image->array_layers);
+   }
+
+   /* The subresource has one aspect.  An image with a modifier has memory
+    * planes, and a linear multi-planar image has planes, in place of the
+    * color aspect.
+    */
+   const VkImageAspectFlags aspect = subres->aspectMask;
+   const VkImageAspectFlags depth_stencil =
+      vkr_format_get_depth_stencil_aspects(image->format);
+   uint32_t plane;
+   bool ok;
+   if (image->tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT)
+      ok = vkr_image_aspect_is_memory_plane(aspect);
+   else if (depth_stencil)
+      ok = util_is_power_of_two_nonzero(aspect) && !(aspect & ~depth_stencil);
+   else if (vkr_image_get_plane(image, aspect, &plane))
+      ok = true;
+   else
+      ok = aspect == VK_IMAGE_ASPECT_COLOR_BIT &&
+           (image->plane_count == 1 || image->tiling != VK_IMAGE_TILING_LINEAR);
+   if (!ok) {
+      return vkr_validate_fail("image subresource: aspects 0x%x do not match format %d",
+                               aspect, image->format);
+   }
+
+   return true;
+}
+
+bool
+vkr_validate_image_planes(const struct vkr_image_info *image,
+                          bool has_plane,
+                          VkImageAspectFlags plane_aspect,
+                          uint32_t *planes)
+{
+   if (!image)
+      return vkr_validate_fail("image: a command gave no image");
+
+   /* the driver ignores the plane of an image that is not disjoint */
+   const uint32_t all_planes = BITFIELD_MASK(image->plane_count);
+   if (!(image->flags & VK_IMAGE_CREATE_DISJOINT_BIT) || image->plane_count == 1) {
+      *planes = all_planes;
+      return true;
+   }
+
+   uint32_t plane;
+   if (has_plane && image->tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT &&
+       vkr_image_aspect_is_memory_plane(plane_aspect)) {
+      *planes = all_planes;
+      return true;
+   }
+   if (has_plane && image->tiling != VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT &&
+       vkr_image_get_plane(image, plane_aspect, &plane)) {
+      *planes = 1u << plane;
+      return true;
+   }
+
+   return vkr_validate_fail("image: plane aspect 0x%x is not a plane of a disjoint "
+                            "image of format %d",
+                            has_plane ? plane_aspect : 0, image->format);
+}
+
+bool
+vkr_validate_image_view_create_info(struct vkr_physical_device *physical_dev,
+                                    const struct vkr_image_info *image,
+                                    uint32_t bound_planes,
+                                    const VkImageViewCreateInfo *info)
+{
+   if (!info || !image)
+      return vkr_validate_fail("image view: no create info or no image");
+
+   const VkImageSubresourceRange *range = &info->subresourceRange;
+
+   if (range->baseMipLevel >= image->mip_levels) {
+      return vkr_validate_fail("image view: base level %u is not in %u levels",
+                               range->baseMipLevel, image->mip_levels);
+   }
+   const uint32_t level_limit = image->mip_levels - range->baseMipLevel;
+   const uint32_t level_count =
+      range->levelCount == VK_REMAINING_MIP_LEVELS ? level_limit : range->levelCount;
+   if (!level_count || level_count > level_limit) {
+      return vkr_validate_fail("image view: %u levels from level %u are not in %u levels",
+                               level_count, range->baseMipLevel, image->mip_levels);
+   }
+
+   /* a 2D view of a 3D image uses the depth slices of one level as layers */
+   const uint32_t level_depth = u_minify(image->extent.depth, range->baseMipLevel);
+   uint32_t layer_limit = image->array_layers;
+   bool ok;
+   switch (info->viewType) {
+   case VK_IMAGE_VIEW_TYPE_1D:
+   case VK_IMAGE_VIEW_TYPE_1D_ARRAY:
+      ok = image->type == VK_IMAGE_TYPE_1D;
+      break;
+   case VK_IMAGE_VIEW_TYPE_2D:
+   case VK_IMAGE_VIEW_TYPE_2D_ARRAY:
+      if (image->type == VK_IMAGE_TYPE_3D) {
+         VkImageCreateFlags flags = VK_IMAGE_CREATE_2D_ARRAY_COMPATIBLE_BIT;
+         if (info->viewType == VK_IMAGE_VIEW_TYPE_2D)
+            flags |= VK_IMAGE_CREATE_2D_VIEW_COMPATIBLE_BIT_EXT;
+         ok = (image->flags & flags) && level_count == 1;
+         layer_limit = level_depth;
+      } else {
+         ok = image->type == VK_IMAGE_TYPE_2D;
+      }
+      break;
+   case VK_IMAGE_VIEW_TYPE_CUBE:
+   case VK_IMAGE_VIEW_TYPE_CUBE_ARRAY:
+      ok = image->type == VK_IMAGE_TYPE_2D &&
+           (image->flags & VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT);
+      break;
+   case VK_IMAGE_VIEW_TYPE_3D:
+      ok = image->type == VK_IMAGE_TYPE_3D;
+      break;
+   default:
+      ok = false;
+      break;
+   }
+   if (ok && image->samples != VK_SAMPLE_COUNT_1_BIT) {
+      ok = info->viewType == VK_IMAGE_VIEW_TYPE_2D ||
+           info->viewType == VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+   }
+   if (!ok) {
+      return vkr_validate_fail("image view: type %d with %u levels does not match an "
+                               "image of type %d, flags 0x%x, %d samples",
+                               info->viewType, level_count, image->type, image->flags,
+                               image->samples);
+   }
+
+   if (range->baseArrayLayer >= layer_limit) {
+      return vkr_validate_fail("image view: base layer %u is not in %u layers",
+                               range->baseArrayLayer, layer_limit);
+   }
+   const uint32_t layer_count = range->layerCount == VK_REMAINING_ARRAY_LAYERS
+                                   ? layer_limit - range->baseArrayLayer
+                                   : range->layerCount;
+   if (!layer_count || layer_count > layer_limit - range->baseArrayLayer) {
+      return vkr_validate_fail("image view: %u layers from layer %u are not in %u layers",
+                               layer_count, range->baseArrayLayer, layer_limit);
+   }
+   switch (info->viewType) {
+   case VK_IMAGE_VIEW_TYPE_1D:
+   case VK_IMAGE_VIEW_TYPE_2D:
+   case VK_IMAGE_VIEW_TYPE_3D:
+      ok = layer_count == 1;
+      break;
+   case VK_IMAGE_VIEW_TYPE_CUBE:
+      ok = layer_count == 6;
+      break;
+   case VK_IMAGE_VIEW_TYPE_CUBE_ARRAY:
+      ok = layer_count % 6 == 0;
+      break;
+   default:
+      ok = true;
+      break;
+   }
+   if (!ok) {
+      return vkr_validate_fail("image view: type %d does not allow %u layers",
+                               info->viewType, layer_count);
+   }
+
+   /* A plane aspect makes a view of one plane of a multi-planar image.  The
+    * image must have the mutable format flag for that.  Other views have the
+    * color aspect, or depth and stencil aspects of the format.
+    */
+   const VkImageAspectFlags aspects = range->aspectMask;
+   const VkImageAspectFlags depth_stencil =
+      vkr_format_get_depth_stencil_aspects(image->format);
+   uint32_t plane = 0;
+   const bool is_plane_view = vkr_image_get_plane(image, aspects, &plane);
+   if (is_plane_view)
+      ok = image->flags & VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT;
+   else if (depth_stencil)
+      ok = aspects && !(aspects & ~depth_stencil);
+   else
+      ok = aspects == VK_IMAGE_ASPECT_COLOR_BIT;
+   if (!ok) {
+      return vkr_validate_fail("image view: aspects 0x%x do not match an image of "
+                               "format %d, flags 0x%x",
+                               aspects, image->format, image->flags);
+   }
+
+   /* the driver makes its view from the object that a bind command makes */
+   const uint32_t view_planes =
+      is_plane_view ? 1u << plane : BITFIELD_MASK(image->plane_count);
+   if (!(image->flags & VK_IMAGE_CREATE_SPARSE_BINDING_BIT) &&
+       (bound_planes & view_planes) != view_planes)
+      return vkr_validate_fail("image view: the image has no memory");
+
+   const VkComponentMapping *swizzle = &info->components;
+   if ((uint32_t)swizzle->r > VK_COMPONENT_SWIZZLE_A ||
+       (uint32_t)swizzle->g > VK_COMPONENT_SWIZZLE_A ||
+       (uint32_t)swizzle->b > VK_COMPONENT_SWIZZLE_A ||
+       (uint32_t)swizzle->a > VK_COMPONENT_SWIZZLE_A) {
+      return vkr_validate_fail("image view: component swizzle %d, %d, %d, %d is not valid",
+                               swizzle->r, swizzle->g, swizzle->b, swizzle->a);
+   }
+
+   /* the driver gets a query only for a view that changes the format */
+   VkFormatProperties view_format_props = { 0 };
+   if (info->format != image->format)
+      vkr_format_get_features(physical_dev, info->format, &view_format_props);
+   if (is_plane_view) {
+      /* the format of the plane or a format of its class */
+      const uint32_t *plane_formats = vkr_format_get_plane_formats(image->format);
+      ok = plane_formats &&
+           vkr_format_is_compatible(info->format, (VkFormat)plane_formats[plane]);
+   } else if (info->format == image->format) {
+      ok = true;
+   } else if (image->plane_count > 1 ||
+              !(image->flags & VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT)) {
+      ok = false;
+   } else if (vkr_format_is_compatible(info->format, image->format)) {
+      ok = true;
+   } else {
+      /* a view of one subresource of a block image as texel blocks */
+      const struct vkr_format_entry *image_entry = vkr_format_lookup(image->format);
+      const struct vkr_format_entry *view_entry = vkr_format_lookup(info->format);
+      ok = (image->flags & VK_IMAGE_CREATE_BLOCK_TEXEL_VIEW_COMPATIBLE_BIT) &&
+           image_entry && view_entry &&
+           (image_entry->flags & VKR_FORMAT_FLAG_COMPRESSED) && !view_entry->flags &&
+           view_entry->block_size && image_entry->block_size == view_entry->block_size &&
+           level_count == 1 && layer_count == 1 &&
+           info->viewType != VK_IMAGE_VIEW_TYPE_3D;
+   }
+   if (ok && info->format != image->format) {
+      ok = view_format_props.linearTilingFeatures |
+           view_format_props.optimalTilingFeatures;
+   }
+   if (!ok) {
+      return vkr_validate_fail("image view: format %d, aspects 0x%x does not match an "
+                               "image of format %d, flags 0x%x",
+                               info->format, aspects, image->format, image->flags);
+   }
+
+   const VkImageViewSlicedCreateInfoEXT *sliced =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_IMAGE_VIEW_SLICED_CREATE_INFO_EXT);
+   if (sliced) {
+      ok = physical_dev->EXT_image_sliced_view_of_3d &&
+           info->viewType == VK_IMAGE_VIEW_TYPE_3D && level_count == 1 &&
+           sliced->sliceOffset < level_depth &&
+           (sliced->sliceCount == VK_REMAINING_3D_SLICES_EXT ||
+            (sliced->sliceCount &&
+             sliced->sliceCount <= level_depth - sliced->sliceOffset));
+      if (!ok) {
+         return vkr_validate_fail(
+            "image view: slices %u+%u of a view of type %d with %u levels are not in "
+            "depth %u, or the driver has no sliced views",
+            sliced->sliceOffset, sliced->sliceCount, info->viewType, level_count,
+            level_depth);
+      }
+   }
+
+   /* The view has the usage of the image when it gives no usage.  When the
+    * view changes the format, the features of its format must allow its
+    * usage.
+    */
+   VkImageUsageFlags usage = image->usage;
+   const VkImageViewUsageCreateInfo *usage_info =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_IMAGE_VIEW_USAGE_CREATE_INFO);
+   if (usage_info) {
+      if (!usage_info->usage || (usage_info->usage & ~image->usage)) {
+         return vkr_validate_fail("image view: usage 0x%x is not in image usage 0x%x",
+                                  usage_info->usage, image->usage);
+      }
+      usage = usage_info->usage;
+   }
+   if (info->format != image->format) {
+      const VkFormatFeatureFlags features = image->tiling == VK_IMAGE_TILING_LINEAR
+                                               ? view_format_props.linearTilingFeatures
+                                               : view_format_props.optimalTilingFeatures;
+      const VkFormatFeatureFlags attachment = VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT |
+                                              VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT;
+      VkFormatFeatureFlags need = 0;
+      if (usage & VK_IMAGE_USAGE_SAMPLED_BIT)
+         need |= VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+      if (usage & VK_IMAGE_USAGE_STORAGE_BIT)
+         need |= VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT;
+      if (usage & VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT)
+         need |= VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT;
+      if (usage & VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)
+         need |= VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT;
+      if ((features & need) != need ||
+          ((usage & VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT) && !(features & attachment))) {
+         return vkr_validate_fail(
+            "image view: features 0x%x of format %d do not allow usage 0x%x", features,
+            info->format, usage);
+      }
+   }
+
+   return true;
+}
+
+bool
+vkr_validate_bind(bool has_object, bool has_memory)
+{
+   if (!has_object || !has_memory)
+      return vkr_validate_fail("bind: a command gave no object or no memory");
+   return true;
+}
