+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VKR_VALIDATE_H
+#define VKR_VALIDATE_H
+
+#include "vkr_common.h"
+
+/*
+ * Tests of guest create info that must pass before the host driver gets it.
+ *
+ * The Vulkan specification makes the application responsible for valid usage,
+ * and a driver can do anything on invalid usage.  The guest is not trusted, so
+ * the renderer cannot give it that role.  These tests are for the create info
+ * of images, image views, and buffer views: a driver on top of a different
+ * API (Metal) turns them into descriptors, and that API stops the process
+ * when a descriptor is not valid.
+ *
+ * The tests are not a full validation layer.  They are for the valid usage
+ * rules that control the content of those descriptors.
+ */
+
+struct vkr_physical_device;
+
+/* The create info of an image in the form that the driver got. */
+struct vkr_image_info {
+   VkImageCreateFlags flags;
+   VkImageType type;
+   VkFormat format;
+   VkExtent3D extent;
+   uint32_t mip_levels;
+   uint32_t array_layers;
+   VkSampleCountFlagBits samples;
+   VkImageTiling tiling;
+   VkImageUsageFlags usage; /* includes the stencil usage */
+   uint32_t plane_count;    /* 1 for a format that is not multi-planar */
+};
+
+/* The create info of a buffer. */
+struct vkr_buffer_info {
+   VkDeviceSize size;
+   VkBufferUsageFlags2 usage;
+   bool sparse;
+};
+
+/*
+ * Returns true when the driver can get info.  The function can remove create
+ * flags that the host driver cannot use for this image (see
+ * vkr_physical_device::image_3d_alias_quirk); the caller must give the same
+ * info to the driver and to vkr_image_info_init.
+ */
+bool
+vkr_validate_image_create_info(struct vkr_physical_device *physical_dev,
+                               VkImageCreateInfo *info);
+
+void
+vkr_image_info_init(struct vkr_image_info *image, const VkImageCreateInfo *info);
+
+/* Returns true when subres is a subresource of image. */
+bool
+vkr_validate_image_subresource(const struct vkr_image_info *image,
+                               const VkImageSubresource *subres);
+
+/*
+ * For a command that binds memory to image or gets its memory requirements.
+ * has_plane and plane_aspect come from the plane structure of the command.
+ * Sets planes to the bit mask of the planes that the command is for.  image
+ * is NULL when the guest gave no image.
+ */
+bool
+vkr_validate_image_planes(const struct vkr_image_info *image,
+                          bool has_plane,
+                          VkImageAspectFlags plane_aspect,
+                          uint32_t *planes);
+
+/*
+ * bound_planes is the bit mask of the planes that have memory.  image is NULL
+ * when the guest gave no image.
+ */
+bool
+vkr_validate_image_view_create_info(struct vkr_physical_device *physical_dev,
+                                    const struct vkr_image_info *image,
+                                    uint32_t bound_planes,
+                                    const VkImageViewCreateInfo *info);
+
+/* For a command that binds memory to an image or a buffer. */
+bool
+vkr_validate_bind(bool has_object, bool has_memory);
+
+bool
+vkr_validate_buffer_create_info(struct vkr_physical_device *physical_dev,
+                                const VkBufferCreateInfo *info);
+
+void
+vkr_buffer_info_init(struct vkr_buffer_info *buffer, const VkBufferCreateInfo *info);
+
+/* buffer is NULL when the guest gave no buffer. */
+bool
+vkr_validate_buffer_view_create_info(struct vkr_physical_device *physical_dev,
+                                     const struct vkr_buffer_info *buffer,
+                                     bool memory_bound,
+                                     const VkBufferViewCreateInfo *info);
+
+#endif /* VKR_VALIDATE_H */
