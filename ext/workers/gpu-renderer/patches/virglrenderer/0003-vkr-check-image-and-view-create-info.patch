+bool
+vkr_validate_buffer_create_info(struct vkr_physical_device *physical_dev,
+                                const VkBufferCreateInfo *info)
+{
+   if (!info)
+      return vkr_validate_fail("buffer: no create info");
+
+   /* max_buffer_size is 0 when the driver gives no limit */
+   if (!info->size ||
+       (physical_dev->max_buffer_size && info->size > physical_dev->max_buffer_size)) {
+      return vkr_validate_fail("buffer: size %" PRIu64 " is zero or more than %" PRIu64,
+                               info->size, physical_dev->max_buffer_size);
+   }
+
+   return true;
+}
+
+void
+vkr_buffer_info_init(struct vkr_buffer_info *buffer, const VkBufferCreateInfo *info)
+{
+   const VkBufferUsageFlags2CreateInfo *usage_info =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_BUFFER_USAGE_FLAGS_2_CREATE_INFO);
+
+   *buffer = (struct vkr_buffer_info){
+      .size = info->size,
+      .usage = usage_info ? usage_info->usage : info->usage,
+      .sparse = info->flags & VK_BUFFER_CREATE_SPARSE_BINDING_BIT,
+   };
+}
+
+/* Returns the alignment that the offset of a buffer view must have. */
+static VkDeviceSize
+vkr_buffer_view_get_alignment(const struct vkr_physical_device *physical_dev,
+                              bool storage,
+                              uint32_t texel_size)
+{
+   if (!physical_dev->has_texel_buffer_alignment)
+      return physical_dev->properties.limits.minTexelBufferOffsetAlignment;
+
+   const VkPhysicalDeviceTexelBufferAlignmentProperties *props =
+      &physical_dev->texel_buffer_alignment;
+   const VkDeviceSize alignment = storage ? props->storageTexelBufferOffsetAlignmentBytes
+                                          : props->uniformTexelBufferOffsetAlignmentBytes;
+   const bool single_texel = storage ? props->storageTexelBufferOffsetSingleTexelAlignment
+                                     : props->uniformTexelBufferOffsetSingleTexelAlignment;
+   /* The size of a texel, or the size of a component when the format has 3
+    * components.  That is the largest power of two that divides the size.
+    */
+   if (single_texel)
+      return MIN2(alignment, (VkDeviceSize)(texel_size & -texel_size));
+   return alignment;
+}
+
+bool
+vkr_validate_buffer_view_create_info(struct vkr_physical_device *physical_dev,
+                                     const struct vkr_buffer_info *buffer,
+                                     bool memory_bound,
+                                     const VkBufferViewCreateInfo *info)
+{
+   if (!info || !buffer)
+      return vkr_validate_fail("buffer view: no create info or no buffer");
+
+   if (!buffer->sparse && !memory_bound)
+      return vkr_validate_fail("buffer view: the buffer has no memory");
+
+   if (info->offset >= buffer->size) {
+      return vkr_validate_fail("buffer view: offset %" PRIu64
+                               " is not in a buffer of %" PRIu64 " bytes",
+                               info->offset, buffer->size);
+   }
+   const VkDeviceSize range =
+      info->range == VK_WHOLE_SIZE ? buffer->size - info->offset : info->range;
+   if (range > buffer->size - info->offset) {
+      return vkr_validate_fail("buffer view: range %" PRIu64 " from offset %" PRIu64
+                               " is not in a buffer of %" PRIu64 " bytes",
+                               range, info->offset, buffer->size);
+   }
+
+   /* The view has the texel buffer usage of the buffer, or a part of it. */
+   const VkBufferUsageFlags2 texel_usage = VK_BUFFER_USAGE_2_UNIFORM_TEXEL_BUFFER_BIT |
+                                           VK_BUFFER_USAGE_2_STORAGE_TEXEL_BUFFER_BIT;
+   VkBufferUsageFlags2 usage = buffer->usage & texel_usage;
+   const VkBufferUsageFlags2CreateInfo *usage_info =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_BUFFER_USAGE_FLAGS_2_CREATE_INFO);
+   if (usage_info) {
+      if ((usage_info->usage & ~texel_usage) || (usage_info->usage & ~buffer->usage))
+         usage = 0;
+      else
+         usage = usage_info->usage;
+   }
+   if (!usage) {
+      return vkr_validate_fail(
+         "buffer view: buffer usage 0x%" PRIx64 " does not allow the view",
+         buffer->usage);
+   }
+
+   const struct vkr_format_entry *entry = vkr_format_lookup(info->format);
+   VkFormatProperties props;
+   vkr_format_get_features(physical_dev, info->format, &props);
+   VkFormatFeatureFlags need = 0;
+   if (usage & VK_BUFFER_USAGE_2_UNIFORM_TEXEL_BUFFER_BIT)
+      need |= VK_FORMAT_FEATURE_UNIFORM_TEXEL_BUFFER_BIT;
+   if (usage & VK_BUFFER_USAGE_2_STORAGE_TEXEL_BUFFER_BIT)
+      need |= VK_FORMAT_FEATURE_STORAGE_TEXEL_BUFFER_BIT;
+   if (!entry || !entry->block_size || entry->flags ||
+       (props.bufferFeatures & need) != need) {
+      return vkr_validate_fail(
+         "buffer view: no driver support for format %d with usage 0x%" PRIx64,
+         info->format, usage);
+   }
+
+   const VkDeviceSize elements = range / entry->block_size;
+   if (!elements || elements > physical_dev->properties.limits.maxTexelBufferElements) {
+      return vkr_validate_fail(
+         "buffer view: %" PRIu64 " elements of format %d are zero or more than %u",
+         elements, info->format, physical_dev->properties.limits.maxTexelBufferElements);
+   }
+
+   for (int storage = 0; storage < 2; storage++) {
+      const VkBufferUsageFlags2 bit = storage ? VK_BUFFER_USAGE_2_STORAGE_TEXEL_BUFFER_BIT
+                                              : VK_BUFFER_USAGE_2_UNIFORM_TEXEL_BUFFER_BIT;
+      const VkDeviceSize alignment =
+         vkr_buffer_view_get_alignment(physical_dev, storage, entry->block_size);
+      if ((usage & bit) && alignment && info->offset % alignment) {
+         return vkr_validate_fail("buffer view: offset %" PRIu64
+                                  " is not a multiple of %" PRIu64,
+                                  info->offset, alignment);
+      }
+   }
+
+   return true;
+}
