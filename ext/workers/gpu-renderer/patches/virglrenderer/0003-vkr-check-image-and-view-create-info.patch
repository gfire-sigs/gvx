diff --git a/src/venus/vkr_buffer.c b/src/venus/vkr_buffer.c
index bba1f6a..421ae58 100644
--- a/src/venus/vkr_buffer.c
+++ b/src/venus/vkr_buffer.c
@@ -7,6 +7,7 @@
 
 #include "vkr_buffer_gen.h"
 #include "vkr_physical_device.h"
+#include "vkr_validate.h"
 
 static void
 vkr_dispatch_vkCreateBuffer(struct vn_dispatch_context *dispatch,
@@ -37,7 +38,21 @@ vkr_dispatch_vkCreateBuffer(struct vn_dispatch_context *dispatch,
     * vkr_physical_device_init_memory_properties as well.
     */
 
-   vkr_buffer_create_and_add(dispatch->data, args);
+   /* a driver gives this result for a size that is more than its limit */
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   const VkBufferCreateInfo *info = args->pCreateInfo;
+   if (!vkr_validate_buffer_create_info(dev->physical_device, info)) {
+      args->ret = info && info->size ? VK_ERROR_OUT_OF_DEVICE_MEMORY
+                                     : VK_ERROR_VALIDATION_FAILED;
+      return;
+   }
+
+   /* set the info before a command of a different ring can find the buffer */
+   struct vkr_buffer *buf = vkr_buffer_create(dispatch->data, args);
+   if (!buf)
+      return;
+   vkr_buffer_info_init(&buf->info, info);
+   vkr_device_add_object(dispatch->data, dev, &buf->base);
 }
 
 static void
@@ -49,12 +64,17 @@ vkr_dispatch_vkDestroyBuffer(struct vn_dispatch_context *dispatch,
 
 static void
 vkr_dispatch_vkGetBufferMemoryRequirements(
-   UNUSED struct vn_dispatch_context *dispatch,
+   struct vn_dispatch_context *dispatch,
    struct vn_command_vkGetBufferMemoryRequirements *args)
 {
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
 
+   if (!args->buffer) {
+      vkr_context_set_fatal(dispatch->data);
+      return;
+   }
+
    vn_replace_vkGetBufferMemoryRequirements_args_handle(args);
    vk->GetBufferMemoryRequirements(args->device, args->buffer, args->pMemoryRequirements);
    vkr_physical_device_mem_type_spoof(dev->physical_device,
@@ -63,12 +83,17 @@ vkr_dispatch_vkGetBufferMemoryRequirements(
 
 static void
 vkr_dispatch_vkGetBufferMemoryRequirements2(
-   UNUSED struct vn_dispatch_context *dispatch,
+   struct vn_dispatch_context *dispatch,
    struct vn_command_vkGetBufferMemoryRequirements2 *args)
 {
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
 
+   if (!args->pInfo || !args->pInfo->buffer) {
+      vkr_context_set_fatal(dispatch->data);
+      return;
+   }
+
    vn_replace_vkGetBufferMemoryRequirements2_args_handle(args);
    vk->GetBufferMemoryRequirements2(args->device, args->pInfo, args->pMemoryRequirements);
    vkr_physical_device_mem_type_spoof(
@@ -83,9 +108,17 @@ vkr_dispatch_vkBindBufferMemory(UNUSED struct vn_dispatch_context *dispatch,
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
 
+   struct vkr_buffer *buf = vkr_buffer_from_handle(args->buffer);
+   if (!vkr_validate_bind(buf != NULL, args->memory != VK_NULL_HANDLE)) {
+      args->ret = VK_ERROR_VALIDATION_FAILED;
+      return;
+   }
+
    vn_replace_vkBindBufferMemory_args_handle(args);
    args->ret =
       vk->BindBufferMemory(args->device, args->buffer, args->memory, args->memoryOffset);
+   if (args->ret == VK_SUCCESS)
+      atomic_store(&buf->memory_bound, true);
 }
 
 static void
@@ -95,8 +128,32 @@ vkr_dispatch_vkBindBufferMemory2(UNUSED struct vn_dispatch_context *dispatch,
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
 
+   STACK_ARRAY(struct vkr_buffer *, bufs, args->bindInfoCount);
+   if (!bufs) {
+      args->ret = VK_ERROR_OUT_OF_HOST_MEMORY;
+      return;
+   }
+
+   bool ok = args->pBindInfos || !args->bindInfoCount;
+   for (uint32_t i = 0; ok && i < args->bindInfoCount; i++) {
+      const VkBindBufferMemoryInfo *info = &args->pBindInfos[i];
+
+      bufs[i] = vkr_buffer_from_handle(info->buffer);
+      ok = vkr_validate_bind(bufs[i] != NULL, info->memory != VK_NULL_HANDLE);
+   }
+   if (!ok) {
+      args->ret = VK_ERROR_VALIDATION_FAILED;
+      STACK_ARRAY_FINISH(bufs);
+      return;
+   }
+
    vn_replace_vkBindBufferMemory2_args_handle(args);
    args->ret = vk->BindBufferMemory2(args->device, args->bindInfoCount, args->pBindInfos);
+   if (args->ret == VK_SUCCESS) {
+      for (uint32_t i = 0; i < args->bindInfoCount; i++)
+         atomic_store(&bufs[i]->memory_bound, true);
+   }
+   STACK_ARRAY_FINISH(bufs);
 }
 
 static void
@@ -126,6 +183,16 @@ static void
 vkr_dispatch_vkCreateBufferView(struct vn_dispatch_context *dispatch,
                                 struct vn_command_vkCreateBufferView *args)
 {
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   const VkBufferViewCreateInfo *info = args->pCreateInfo;
+   struct vkr_buffer *buf = info ? vkr_buffer_from_handle(info->buffer) : NULL;
+   if (!vkr_validate_buffer_view_create_info(
+          dev->physical_device, buf ? &buf->info : NULL,
+          buf ? atomic_load(&buf->memory_bound) : false, info)) {
+      args->ret = VK_ERROR_VALIDATION_FAILED;
+      return;
+   }
+
    vkr_buffer_view_create_and_add(dispatch->data, args);
 }
 
@@ -138,12 +205,18 @@ vkr_dispatch_vkDestroyBufferView(struct vn_dispatch_context *dispatch,
 
 static void
 vkr_dispatch_vkGetDeviceBufferMemoryRequirements(
-   UNUSED struct vn_dispatch_context *ctx,
+   struct vn_dispatch_context *ctx,
    struct vn_command_vkGetDeviceBufferMemoryRequirements *args)
 {
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
 
+   if (!args->pInfo ||
+       !vkr_validate_buffer_create_info(dev->physical_device, args->pInfo->pCreateInfo)) {
+      vkr_context_set_fatal(ctx->data);
+      return;
+   }
+
    vn_replace_vkGetDeviceBufferMemoryRequirements_args_handle(args);
    vk->GetDeviceBufferMemoryRequirements(args->device, args->pInfo,
                                          args->pMemoryRequirements);
diff --git a/src/venus/vkr_buffer.h b/src/venus/vkr_buffer.h
index d1575b5..825ad0b 100644
--- a/src/venus/vkr_buffer.h
+++ b/src/venus/vkr_buffer.h
@@ -8,8 +8,14 @@
 
 #include "vkr_common.h"
 
+#include "vkr_validate.h"
+
 struct vkr_buffer {
    struct vkr_object base;
+
+   /* for the tests of the buffer views of the buffer */
+   struct vkr_buffer_info info;
+   atomic_bool memory_bound;
 };
 VKR_DEFINE_OBJECT_CAST(buffer, VK_OBJECT_TYPE_BUFFER, VkBuffer)
 
