From 33b2fd0cae8a0130d674036f9437a6b6c8cc98e3 Mon Sep 17 00:00:00 2001
From: The gVisor Authors <gvisor-dev@googlegroups.com>
Date: Sun, 22 Nov 2026 17:37:04 +0900
Subject: [PATCH] vrend: fix bounds test and upload loop in
 vrend_resource_copy_fallback

vrend_resource_copy_fallback tested
slice_offset + width * height + cube_slice * slice_size > total_size.
For a 2D texture total_size equals slice_size, so the sum always
exceeded total_size. vrend logged "Offset out of bound: 0" and skipped
the copy on hosts without GL_ARB_copy_image.

The old code also had three safety defects. slice_size, total_size, and
slice_offset used 32-bit products that could overflow malloc. The upload
loop followed src_res->target instead of dst_res->target, so copies
between cube maps and 3D or array targets over-read or dropped faces.
3D and array uploads checked one slice while reading depth slices.

Compute slice_size, total_size, and slice_offset in 64 bits and reject
sizes above INT_MAX or SIZE_MAX. Drive uploads from dst_res->target. For
a cube map destination, verify slice_offset + depth * slice_size <=
total_size and upload each face dstz + k. For other destinations, run
one upload and verify slice_offset + slices_read * slice_size <=
total_size.

License: MIT
---
 src/vrend/vrend_renderer.c | 114 +++++++++++++++++++++++++++----------
 1 file changed, 83 insertions(+), 31 deletions(-)

diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index e00da44..91b8e4a 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -11019,12 +11019,12 @@ static void vrend_resource_copy_fallback(struct vrend_resource *src_res,
                                          const struct pipe_box *src_box)
 {
    char *tptr;
-   uint32_t total_size, src_stride, dst_stride, src_layer_stride;
+   uint32_t src_stride, dst_stride, src_layer_stride;
    GLenum glformat, gltype;
    int elsize = util_format_get_blocksize(dst_res->base.format);
    int compressed = util_format_is_compressed(dst_res->base.format);
    int cube_slice = 1;
-   uint32_t slice_size, slice_offset;
+   uint64_t slice_size, total_size, slice_offset;
    int i;
    struct pipe_box box;
 
@@ -11036,16 +11036,41 @@ static void vrend_resource_copy_fallback(struct vrend_resource *src_res,
       return;
    }
 
+   if (src_box->width <= 0 || src_box->height <= 0 || src_box->depth <= 0 ||
+       src_box->z < 0 || elsize <= 0)
+      return;
+
+   uint32_t src_depth = vrend_get_texture_depth(src_res, src_level);
+   if (src_depth == 0 ||
+       (src_res->target == GL_TEXTURE_CUBE_MAP && src_depth < 6)) {
+      virgl_error("Copy fallback depth out of range: %u\n", src_depth);
+      return;
+   }
+
    box = *src_box;
-   box.depth = vrend_get_texture_depth(src_res, src_level);
+   box.depth = src_depth;
    dst_stride = util_format_get_stride(dst_res->base.format, dst_res->base.width0);
 
-   /* this is ugly need to do a full GetTexImage */
-   slice_size = util_format_get_nblocks(src_res->base.format, u_minify(src_res->base.width0, src_level), u_minify(src_res->base.height0, src_level)) *
-                util_format_get_blocksize(src_res->base.format);
-   total_size = slice_size * vrend_get_texture_depth(src_res, src_level);
+   /* Compute buffer sizes in 64 bits and bound them to what malloc and
+    * GLsizei-based readback or upload calls can accept. */
+   uint64_t max_copy_size = MIN2((uint64_t)INT_MAX, (uint64_t)SIZE_MAX);
+   uint64_t nblocksx = util_format_get_nblocksx(src_res->base.format,
+                                                u_minify(src_res->base.width0, src_level));
+   uint64_t nblocksy = util_format_get_nblocksy(src_res->base.format,
+                                                u_minify(src_res->base.height0, src_level));
+   uint64_t nblocks = nblocksx * nblocksy;
+   if (nblocks == 0 || nblocks > max_copy_size / (uint64_t)elsize) {
+      virgl_error("Copy fallback size out of range\n");
+      return;
+   }
+   slice_size = nblocks * (uint64_t)elsize;
+   if (slice_size > max_copy_size / src_depth) {
+      virgl_error("Copy fallback size out of range\n");
+      return;
+   }
+   total_size = slice_size * src_depth;
 
-   tptr = malloc(total_size);
+   tptr = malloc((size_t)total_size);
    if (!tptr)
       return;
 
@@ -11083,7 +11108,7 @@ static void vrend_resource_copy_fallback(struct vrend_resource *src_res,
          as 32-bit scaled integers, so we need to scale them here */
       if (dst_res->base.format == VIRGL_FORMAT_Z24X8_UNORM) {
          float depth_scale = 256.0;
-         vrend_scale_depth(tptr, total_size, depth_scale);
+         vrend_scale_depth(tptr, (int)total_size, depth_scale);
       }
 
       /* if this is a BGR* resource on GLES, the data needs to be manually swizzled to RGB* before
@@ -11095,7 +11120,7 @@ static void vrend_resource_copy_fallback(struct vrend_resource *src_res,
       if (vrend_state.use_gles && vrend_format_is_bgra(dst_res->base.format))
          vrend_swizzle_data_bgra(total_size, tptr);
    } else {
-      uint32_t read_chunk_size;
+      GLsizei read_chunk_size;
       switch (elsize) {
       case 1:
       case 3:
@@ -11115,7 +11140,7 @@ static void vrend_resource_copy_fallback(struct vrend_resource *src_res,
       }
       glBindTexture(src_res->target, src_res->gl_id);
       slice_offset = 0;
-      read_chunk_size = (src_res->target == GL_TEXTURE_CUBE_MAP) ? slice_size : total_size;
+      read_chunk_size = (GLsizei)((src_res->target == GL_TEXTURE_CUBE_MAP) ? slice_size : total_size);
       for (i = 0; i < cube_slice; i++) {
          GLenum ctarget = src_res->target == GL_TEXTURE_CUBE_MAP ?
                             (GLenum)(GL_TEXTURE_CUBE_MAP_POSITIVE_X + i) : src_res->target;
@@ -11154,39 +11179,66 @@ static void vrend_resource_copy_fallback(struct vrend_resource *src_res,
    }
 
    glBindTexture(dst_res->target, dst_res->gl_id);
-   slice_offset = src_box->z * slice_size;
-   cube_slice = (src_res->target == GL_TEXTURE_CUBE_MAP) ? src_box->z + src_box->depth : cube_slice;
-   i = (src_res->target == GL_TEXTURE_CUBE_MAP) ? src_box->z : 0;
-   if (slice_offset + src_box->width * src_box->height + cube_slice * slice_size > total_size) {
-      virgl_error("Offset out of bound: %d\n", src_box->z);
-      goto cleanup;
-   }
-
-   for (; i < cube_slice; i++) {
-      GLenum ctarget = dst_res->target == GL_TEXTURE_CUBE_MAP ?
-                          (GLenum)(GL_TEXTURE_CUBE_MAP_POSITIVE_X + i) : dst_res->target;
+   slice_offset = (uint64_t)src_box->z * slice_size;
+   if (dst_res->target == GL_TEXTURE_CUBE_MAP) {
+      uint64_t slices_read = (uint64_t)src_box->depth;
+      if (dstz >= 6 || slices_read > 6 - dstz ||
+          slice_offset + slices_read * slice_size > total_size) {
+         virgl_error("Offset out of bound: %d\n", src_box->z);
+         goto cleanup;
+      }
+      for (uint32_t k = 0; k < (uint32_t)src_box->depth; k++) {
+         GLenum ctarget = (GLenum)(GL_TEXTURE_CUBE_MAP_POSITIVE_X + dstz + k);
+         const char *src_ptr = tptr + slice_offset + (uint64_t)k * slice_size;
+         if (compressed) {
+            glCompressedTexSubImage2D(ctarget, dst_level, dstx, dsty,
+                                      src_box->width, src_box->height,
+                                      glformat, (GLsizei)slice_size, src_ptr);
+         } else {
+            glTexSubImage2D(ctarget, dst_level, dstx, dsty,
+                            src_box->width, src_box->height,
+                            glformat, gltype, src_ptr);
+         }
+      }
+   } else {
+      GLenum ctarget = dst_res->target;
+      bool is_3d_target = (ctarget == GL_TEXTURE_3D ||
+                           ctarget == GL_TEXTURE_2D_ARRAY ||
+                           ctarget == GL_TEXTURE_CUBE_MAP_ARRAY);
+      uint64_t slices_read = is_3d_target ? (uint64_t)src_box->depth : 1;
+      if (slice_offset + slices_read * slice_size > total_size) {
+         virgl_error("Offset out of bound: %d\n", src_box->z);
+         goto cleanup;
+      }
+      const char *src_ptr = tptr + slice_offset;
       if (compressed) {
          if (ctarget == GL_TEXTURE_1D) {
             glCompressedTexSubImage1D(ctarget, dst_level, dstx,
                                       src_box->width,
-                                      glformat, slice_size, tptr + slice_offset);
+                                      glformat, (GLsizei)slice_size, src_ptr);
+         } else if (is_3d_target) {
+            glCompressedTexSubImage3D(ctarget, dst_level, dstx, dsty, dstz,
+                                      src_box->width, src_box->height, src_box->depth,
+                                      glformat, (GLsizei)(slices_read * slice_size), src_ptr);
          } else {
             glCompressedTexSubImage2D(ctarget, dst_level, dstx, dsty,
                                       src_box->width, src_box->height,
-                                      glformat, slice_size, tptr + slice_offset);
+                                      glformat, (GLsizei)slice_size, src_ptr);
          }
       } else {
          if (ctarget == GL_TEXTURE_1D) {
-            glTexSubImage1D(ctarget, dst_level, dstx, src_box->width, glformat, gltype, tptr + slice_offset);
-         } else if (ctarget == GL_TEXTURE_3D ||
-                    ctarget == GL_TEXTURE_2D_ARRAY ||
-                    ctarget == GL_TEXTURE_CUBE_MAP_ARRAY) {
-            glTexSubImage3D(ctarget, dst_level, dstx, dsty, dstz, src_box->width, src_box->height, src_box->depth, glformat, gltype, tptr + slice_offset);
+            glTexSubImage1D(ctarget, dst_level, dstx, src_box->width,
+                            glformat, gltype, src_ptr);
+         } else if (is_3d_target) {
+            glTexSubImage3D(ctarget, dst_level, dstx, dsty, dstz,
+                            src_box->width, src_box->height, src_box->depth,
+                            glformat, gltype, src_ptr);
          } else {
-            glTexSubImage2D(ctarget, dst_level, dstx, dsty, src_box->width, src_box->height, glformat, gltype, tptr + slice_offset);
+            glTexSubImage2D(ctarget, dst_level, dstx, dsty,
+                            src_box->width, src_box->height,
+                            glformat, gltype, src_ptr);
          }
       }
-      slice_offset += slice_size;
    }
 
 cleanup:
-- 
2.55.0

