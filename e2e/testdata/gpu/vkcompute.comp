#version 450
// gvx Vulkan compute probe shader. Each invocation reads one word of src and
// writes one word of dst. vkcompute.c computes the same function on the CPU.
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Dst { uint dst[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    dst[i] = (src[i] * 3u + i) ^ 0xA5A5A5A5u;
}
